{
  "name": "nz-legislation-mcp",
  "mcpName": "io.github.thatskiff33/nz-legislation-mcp",
  "version": "1.0.2",
  "description": "Unofficial, security-hardened MCP server for the New Zealand Legislation API. Bring your own API key.",
  "license": "Apache-2.0",
  "author": "nz-legislation-mcp contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thatskiff33/nz-legislation-mcp.git"
  },
  "bugs": "https://github.com/thatskiff33/nz-legislation-mcp/issues",
  "homepage": "https://github.com/thatskiff33/nz-legislation-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "new-zealand",
    "legislation",
    "law"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.27.1+sha512.a81d4c21b9b09a4b0aebf90ef5e527d4262bdda322d26082978cb549023ac6d9cafc98b19fffaa5c71db438a65f70224edb78d7311187861ff96480d1cdca23c",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip && knip --production --strict",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "generate": "vitest run test/generated.test.ts --update",
    "check:static": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run knip",
    "check": "pnpm run check:static && pnpm run test && pnpm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "@types/sax": "^1.2.7",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "jose": "^6.2.13",
    "sax": "^1.6.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "nz-legislation-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
